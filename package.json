{
  "name": "dsh-plugin-guard",
  "version": "0.3.0",
  "description": "DSH upstream guard with configurable takeover tiers (off/report/stage/review/auto), verified source snapshots and a failure breaker",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node tests/run-all.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "backend",
    "tests"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-gateway"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": "0.2.0-rc.2",
      "dshReleases": {
        "0.2.0-rc.2": "untested"
      },
      "dshOperations": {
        "0.2.0-rc.2": {
          "install": "untested",
          "start": "untested",
          "stop": "untested",
          "uninstall": "untested",
          "rollback": "untested"
        }
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1 || ^3.18.5-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin-manager",
    "upstream-guard",
    "github"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suhong11300/dsh-plugin-guard.git"
  },
  "homepage": "https://github.com/suhong11300/dsh-plugin-guard#readme",
  "bugs": {
    "url": "https://github.com/suhong11300/dsh-plugin-guard/issues"
  },
  "author": {
    "name": "suhong11300"
  },
  "license": "MIT"
}
